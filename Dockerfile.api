FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    AWS_REGION=eu-west-2

WORKDIR /srv/clinic

RUN groupadd --system clinic && useradd --system --gid clinic --home-dir /home/clinic --create-home clinic

COPY requirements.container.txt ./
RUN python -m pip install --no-cache-dir -r requirements.container.txt

# Only runtime code and the public AWS trust certificate are copied.
# No .env, AWS credentials, local ML models, or project history.
COPY --chown=clinic:clinic app/ ./app/
COPY --chown=clinic:clinic certs/global-bundle.pem ./certs/global-bundle.pem

USER clinic
EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/auth/health', timeout=3).read()" || exit 1

CMD ["python", "-m", "uvicorn", "app.api.clinic_auth_backend:app", "--host", "0.0.0.0", "--port", "8000", "--no-access-log", "--workers", "1"]
